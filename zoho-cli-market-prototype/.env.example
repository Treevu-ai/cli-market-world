# CLI Market (required)
CLI_MARKET_API_KEY=sk-your-cli-market-api-key
CLI_MARKET_API_URL=https://cli-market-api.fly.dev
CLI_MARKET_TIMEOUT=30

# Zoho OAuth2 (required to read/write CRM)
# Obtener en: https://api-console.zoho.com
# Scopes: ZohoCRM.modules.ALL, ZohoCRM.settings.ALL
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# Dominio según datacenter: https://www.zohoapis.com (US) | .eu | .in | .com.au
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_TIMEOUT=30

# Opcional: rechaza webhooks sin este header
ZOHO_WEBHOOK_SECRET=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
