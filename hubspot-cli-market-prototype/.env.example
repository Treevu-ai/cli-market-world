# CLI Market (required)
CLI_MARKET_API_KEY=sk-your-cli-market-api-key
CLI_MARKET_API_URL=https://cli-market-api.fly.dev
CLI_MARKET_TIMEOUT=30

# HubSpot Private App Access Token (required to read/write CRM)
# Crear en: HubSpot > Settings > Integrations > Private Apps
# Scopes necesarios: crm.objects.contacts.read/write, crm.objects.deals.read/write
#                    crm.schemas.contacts.write, crm.schemas.deals.write
HUBSPOT_ACCESS_TOKEN=pat-na1-your-access-token-here
HUBSPOT_TIMEOUT=30

# Opcional: rechaza webhooks sin este header
HUBSPOT_WEBHOOK_SECRET=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
