# HubSpot Configuration
# Portal ID confirmed live via the connected HubSpot account (2026-08-11) —
# real value, not a placeholder, since NEXT_PUBLIC_* is baked into the public
# client bundle anyway (never secret).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=51814253
# No form was found under this portal (Forms aren't queryable via the CRM API
# used to confirm the portal ID above) — create it in HubSpot first:
# Marketing > Forms > Create form, fields: email, product_line, tier_intent,
# lead_source (see landing/components/HubSpotLeadForm.tsx for exact field
# names), then paste its form GUID here.
NEXT_PUBLIC_HUBSPOT_FORM_ID=YOUR_HUBSPOT_FORM_ID

# Existing pipeline note: the portal already has "Pipeline Ventas CLI MARKET"
# (internal id "default", standard stages: appointmentscheduled,
# qualifiedtobuy, decisionmakerboughtin, closedwon, presentationscheduled) —
# it does NOT match what ops/n8n-workflows/*.json assume
# (HUBSPOT_PIPELINE_ID=cli_market_procure, stages "New Lead"/"Demo
# Booked"/"Customer"). Decide before wiring n8n: either point the workflows
# at "default" + its real stage names, or create a dedicated
# cli_market_procure pipeline with the 3 stages the workflows expect.

# n8n Webhook URLs — n8n itself doesn't exist anywhere yet (checked: no Fly
# secret, no Cloudflare Pages var, no GitHub Actions secret/var, no URL
# referenced anywhere in this repo or sibling repos). Needs a hosting
# decision (n8n Cloud vs self-host) before these can be real.
NEXT_PUBLIC_N8N_LEAD_SYNC_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-sync
NEXT_PUBLIC_N8N_DEMO_BOOKING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/demo-booking
NEXT_PUBLIC_N8N_BILLING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/billing-webhook
