            }
          ]
        }
      },
      "id": "create-hubspot-deal",
      "name": "Create HubSpot Deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "hubspotApi": {
          "id": "1",
          "name": "HubSpot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format Slack message\nconst productLine = $input.item.json.product_line;\nconst tierIntent = $input.item.json.tier_intent;\nconst email = $input.item.json.email;\nconst dealId = $input.item.json.id;\n\nconst emojis = {\n  'CLI Market Pro': '🛠️',\n  'Procure Starter': '🛒',\n  'Procure Pro': '🚀',\n  'Intelligence': '📊',\n  'Custom': '🎯'\n};\n\nconst emoji = emojis[productLine] || '🆕';\n\nreturn {\n  json: {\n    channel: '#outbound',\n    text: `${emoji} New Lead: ${productLine}`,\n    blocks: [\n      {\n        type: 'header',\n        text: {\n          type: 'plain_text',\n          text: `${emoji} New Lead: ${productLine}`\n        }\n      },\n      {\n        type: 'section',\n        fields: [\n          {\n            type: 'mrkdwn',\n            text: `*Email:*\\n${email}`\n          },\n          {\n            type: 'mrkdwn',\n            text: `*Tier Intent:*\\n${tierIntent}`\n          },\n          {\n            type: 'mrkdwn',\n            text: `*Product Line:*\\n${productLine}`\n          },\n          {\n            type: 'mrkdwn',\n            text: `*Deal ID:*\\n${dealId}`\n          }\n        ]\n      },\n      {\n        type: 'actions',\n        elements: [\n          {\n            type: 'button',\n            text: {\n              type: 'plain_text',\n              text: 'View in HubSpot'\n            },\n            url: `https://app.hubspot.com/contacts/YOUR_PORTAL/deal/${dealId}`\n          }\n        ]\n      }\n    ]\n  }\n};"
      },
      "id": "format-slack-message",
      "name": "Format Slack Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "channel": "={{ $json.channel }}",
        "text": "={{ $json.text }}",
        "blocks": "={{ $json.blocks }}",
        "otherOptions": {}
      },
      "id": "post-to-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1050, 300],
      "credentials": {
        "slackApi": {
          "id": "2",
          "name": "Slack API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"deal_id\": $node[\"Create HubSpot Deal\"].json.id } }}"
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
