    },
    {
      "parameters": {
        "resource": "deal",
        "operation": "create",
        "dealId": {
          "__rl": true,
          "value": "",
          "mode": "name"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "dealname",
              "value": "={{ $json.product_line }} - {{ $json.email }}"
            },
            {
              "key": "dealstage",
              "value": "new_lead"
            },
            {
              "key": "pipeline",
              "value": "cli_market_procure"
            },
