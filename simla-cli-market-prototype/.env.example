# CLI Market (required for live price intelligence)
CLI_MARKET_API_KEY=sk-your-cli-market-api-key
CLI_MARKET_API_URL=https://cli-market-api.fly.dev
CLI_MARKET_TIMEOUT=30

# Simla.com (required to send WhatsApp replies; dry-run if empty)
SIMLA_API_KEY=your-simla-api-key
SIMLA_API_URL=https://YOUR_TENANT.simla.com
SIMLA_WHATSAPP_PATH=/api/v1/messages/whatsapp
SIMLA_HEALTH_PATH=/api/v1/health
SIMLA_TIMEOUT=30

# Optional: reject webhooks without this shared secret
SIMLA_WEBHOOK_SECRET=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
